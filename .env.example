# Copy to .env. Offline mode makes no external AI calls; generated art is visibly labeled test art.
AI_MODE=offline
OPENAI_API_KEY=
TEXT_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1.5
ECONOMY_IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=low
IMAGE_SIZE=1024x1536
# Confirm current provider prices and set conservative per-image charge ceilings before live mode.
PRICING_CONFIRMED=false
INPUT_USD_PER_MILLION=1.0
OUTPUT_USD_PER_MILLION=5.0
PREVIEW_IMAGE_RESERVATION_USD=0.25
FINAL_IMAGE_RESERVATION_USD=1.0
MAX_IMAGE_REFERENCES=8
MAX_REFERENCE_BYTES=8388608
# Local mode defaults to SQLite and local object storage in backend/data. For Compose:
POSTGRES_PASSWORD=
# Use at least 32 random characters for multi-process/production deployments. Local mode creates a persistent key.
JWT_SECRET=
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
# S3 uses the normal AWS credential chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / workload identity).
# Never put keys in NEXT_PUBLIC variables or commit .env.
